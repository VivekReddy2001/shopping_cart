{
  "name": "kartly",
  "version": "2.0.0",
  "description": "Kartly — a full-stack e-commerce shopping cart built with Node.js, Express, MongoDB and EJS: product catalogue with filters and voice search, cart, checkout, PDF invoices, order tracking and an admin dashboard.",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.js",
    "seed:reset": "node scripts/seed.js --reset",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "ecommerce",
    "shopping-cart",
    "nodejs",
    "express",
    "mongodb",
    "mongoose",
    "ejs",
    "rest-api",
    "web-speech-api"
  ],
  "author": "Vivek Reddy (https://github.com/VivekReddy2001)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VivekReddy2001/shopping_cart.git"
  },
  "bugs": {
    "url": "https://github.com/VivekReddy2001/shopping_cart/issues"
  },
  "homepage": "https://github.com/VivekReddy2001/shopping_cart#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.5",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "nodemailer": "^10.0.9",
    "pdfkit": "^0.20.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ]
  }
}
