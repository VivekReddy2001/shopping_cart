{
  "name": "kartly",
  "version": "2.0.0",
  "description": "Kartly — a full-stack e-commerce shopping cart built with Node.js, Express, MongoDB and EJS: product catalogue with filters and voice search, cart, checkout, PDF invoices, order tracking and an admin dashboard.",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.js",
    "seed:reset": "node scripts/seed.js --reset",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "ecommerce",
    "shopping-cart",
    "nodejs",
    "express",
    "mongodb",
    "mongoose",
    "ejs",
    "rest-api",
    "web-speech-api"
  ],
  "author": "Vivek Reddy (https://github.com/VivekReddy2001)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VivekReddy2001/shopping_cart.git"
  },
  "bugs": {
    "url": "https://github.com/VivekReddy2001/shopping_cart/issues"
  },
  "homepage": "https://github.com/VivekReddy2001/shopping_cart#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.5",
    "connect-mongo": "^6.0.0",
    "dotenv": "^18.0.6",
    "ejs": "^6.0.1",
    "express": "^5.1.0",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "mongoose": "^9.11.1",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.16",
    "pdfkit": "^0.20.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ]
  }
}
