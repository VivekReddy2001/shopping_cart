# ─────────────────────────────────────────────────────────────
# Kartly — environment variables
# Copy this file to `.env` and adjust. Every variable is optional
# in development; MONGODB_URI and SESSION_SECRET are required
# when NODE_ENV=production.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# MongoDB connection string. Leave empty in development to start an
# in-memory MongoDB automatically (data resets on every restart).
# Local:  mongodb://127.0.0.1:27017/kartly
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kartly?retryWrites=true&w=majority
MONGODB_URI=

# Long random string used to sign session cookies (min 32 chars in production).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Seed the demo catalogue automatically when the database is empty.
AUTO_SEED=true
# Also create sample customers and orders so the admin dashboard has data.
SEED_DEMO_ORDERS=true
# Create the public demo accounts (demo customer + read-only demo admin).
DEMO_ACCOUNTS=true

# Your real admin account (created by the seeder if it does not exist).
ADMIN_NAME=Vivek Reddy
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Store settings
CURRENCY=INR
LOCALE=en-IN
TIMEZONE=Asia/Kolkata
TAX_RATE=0.18
SHIPPING_FEE=49
FREE_SHIPPING_THRESHOLD=999

# Email (optional). Without SMTP_HOST, emails are printed to the console.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=you@gmail.com, SMTP_PASS=<16-character Google App Password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kartly <no-reply@example.com>"
SUPPORT_EMAIL=support@example.com

# Log level: error | warn | info | debug
LOG_LEVEL=info

# Advanced
# TRUST_PROXY=1            # number of reverse proxies in front of the app (Render: 1)
# COOKIE_SECURE=true       # HTTPS-only cookies (defaults to true in production)
# SESSION_MAX_AGE_DAYS=7
# UPLOAD_MAX_MB=2
