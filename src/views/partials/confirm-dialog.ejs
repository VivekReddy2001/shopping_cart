<dialog class="dialog" id="confirm-dialog" aria-labelledby="confirm-title">
  <form method="dialog">
    <div class="dialog-body">
      <h2 id="confirm-title" data-confirm-title>Are you sure?</h2>
      <p data-confirm-message></p>
    </div>
    <div class="dialog-actions">
      <button class="btn btn-ghost" value="cancel">Keep it</button>
      <button class="btn btn-primary" value="confirm" data-confirm-ok>Confirm</button>
    </div>
  </form>
</dialog>
