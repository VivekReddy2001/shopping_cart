<%# Shared by the customer order page and the admin order page. %>
<div class="order-layout">
  <div class="stack">
    <section class="card">
      <div class="card-header"><h2>Tracking</h2><%- include('status-badge', { status: order.status }) %></div>
      <div class="card-body"><%- include('order-timeline') %></div>
    </section>

    <section class="card">
      <div class="card-header"><h2>Items (<%= order.items.reduce((s, i) => s + i.quantity, 0) %>)</h2></div>
      <div class="card-body">
        <div class="table-wrap">
          <table class="item-table">
            <thead><tr><th scope="col">Product</th><th scope="col" class="text-right">Price</th><th scope="col" class="text-right">Qty</th><th scope="col" class="text-right">Total</th></tr></thead>
            <tbody>
              <% order.items.forEach(function (i) { %>
                <tr>
                  <td><div class="item"><img src="<%= i.image %>" alt="" width="56" height="56" loading="lazy"><div><a href="/products/<%= i.slug %>"><%= i.name %></a><div class="muted small"><%= [i.brand, i.category].filter(Boolean).join(' · ') %></div></div></div></td>
                  <td class="text-right num"><%= formatPrice(i.price) %></td>
                  <td class="text-right num"><%= i.quantity %></td>
                  <td class="text-right num"><strong><%= formatPrice(i.lineTotal) %></strong></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>

  <aside class="stack">
    <section class="card">
      <div class="card-header"><h2>Payment summary</h2></div>
      <div class="card-body">
        <div class="summary-rows">
          <div class="summary-row"><span>Subtotal</span><span class="num"><%= formatPrice(order.amounts.subtotal) %></span></div>
          <div class="summary-row"><span>Shipping</span><span class="num <%= order.amounts.shipping ? '' : 'free' %>"><%= order.amounts.shipping ? formatPrice(order.amounts.shipping) : 'Free' %></span></div>
          <div class="summary-row total"><span>Total</span><span class="num"><%= formatPrice(order.amounts.total) %></span></div>
          <p class="muted small mb-0">Includes <%= formatPrice(order.amounts.tax) %> GST</p>
        </div>
        <dl class="kv mt-2">
          <div><dt>Method</dt><dd><%= PAYMENT_METHODS[order.payment.method] %></dd></div>
          <div><dt>Status</dt><dd><span class="badge badge-<%= PAYMENT_STATUS_META[order.payment.status].tone %>"><%= PAYMENT_STATUS_META[order.payment.status].label %></span></dd></div>
          <% if (order.payment.transactionId) { %><div><dt>Transaction</dt><dd class="num small"><%= order.payment.transactionId %></dd></div><% } %>
          <div><dt>Invoice</dt><dd class="num small"><%= order.invoiceNumber %></dd></div>
        </dl>
      </div>
    </section>

    <section class="card">
      <div class="card-header"><h2>Delivery address</h2></div>
      <div class="card-body">
        <% const a = order.shippingAddress; %>
        <address class="address"><strong><%= a.fullName %></strong><br><%= a.line1 %><% if (a.line2) { %><br><%= a.line2 %><% } %><br><%= a.city %>, <%= a.state %> <%= a.postalCode %><br><%= a.country %><br><%- icon('phone', 'icon-sm') %> <%= a.phone %></address>
      </div>
    </section>

    <section class="card">
      <div class="card-header"><h2>History</h2></div>
      <div class="card-body">
        <ol class="history">
          <% order.statusHistory.slice().reverse().forEach(function (e) { %>
            <li><span class="bullet"></span><div><strong><%= statusLabel(e.status) %></strong><% if (e.note) { %> — <span class="muted"><%= e.note %></span><% } %><time datetime="<%= new Date(e.at).toISOString() %>"><%= formatDateTime(e.at) %></time></div></li>
          <% }) %>
        </ol>
      </div>
    </section>
  </aside>
</div>
