<%- include('_top') %>
<h1 style="margin:0 0 12px;font-size:22px;">Welcome aboard, <%= user.name.split(' ')[0] %>!</h1>
<p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#374151;">
  Your <%= appName %> account is ready. Browse phones, laptops, fashion and home essentials,
  save items to your cart and check out in a few taps.
</p>
<p style="margin:24px 0;">
  <a href="<%= shopUrl %>" style="background:#6d28d9;color:#ffffff;text-decoration:none;padding:12px 22px;border-radius:10px;font-weight:600;display:inline-block;">Start shopping</a>
</p>
<p style="margin:0;font-size:13px;color:#6b7280;">Tip: tap the microphone in the search bar and say “laptops under 60000”.</p>
<%- include('_bottom') %>
