<div class="container page">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol><li><a href="/">Home</a></li><li><a href="/orders">Orders</a></li><li><span aria-current="page"><%= order.orderNumber %></span></li></ol>
  </nav>

  <% if (placed) { %>
    <div class="order-banner" role="status">
      <span class="icon-wrap"><%- icon('check') %></span>
      <div>
        <h2>Thank you! Your order has been placed.</h2>
        <p>We’ve sent a confirmation to <strong><%= order.customer.email %></strong>. You can track progress and download your invoice below.</p>
      </div>
    </div>
  <% } %>

  <div class="order-head">
    <div>
      <h1 class="num">Order <%= order.orderNumber %></h1>
      <p class="muted mb-0">Placed on <%= formatDateTime(order.createdAt) %> · <%= STATUS_META[order.status].description %></p>
    </div>
    <div class="row">
      <a class="btn" href="/orders/<%= order.orderNumber %>/invoice.pdf"><%- icon('download') %> Invoice PDF</a>
      <a class="btn btn-ghost" href="/orders/<%= order.orderNumber %>/invoice" target="_blank" rel="noopener"><%- icon('printer') %> Print</a>
      <% if (canCancel) { %>
        <form action="/orders/<%= order.orderNumber %>/cancel" method="post" data-confirm="Cancel order <%= order.orderNumber %>? Items will be returned to stock<%= order.payment.status === 'PAID' ? ' and your payment refunded' : '' %>." data-confirm-title="Cancel this order?" data-confirm-ok="Yes, cancel order">
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
          <button class="btn btn-danger" type="submit"><%- icon('x-circle') %> Cancel order</button>
        </form>
      <% } %>
    </div>
  </div>

  <%- include('../partials/order-details') %>
</div>
